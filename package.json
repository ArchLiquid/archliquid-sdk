{
  "name": "@archliquid/sdk",
  "version": "0.1.0",
  "description": "Typed integration SDK for ArchLiquid Solana programs",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "idl",
    "docs",
    "examples",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/owned-quote-math.d.ts",
      "import": "./dist/owned-quote-math.js"
    },
    "./accounts": {
      "types": "./dist/owned-program-accounts.d.ts",
      "import": "./dist/owned-program-accounts.js"
    },
    "./instructions": {
      "types": "./dist/owned-program-instructions.d.ts",
      "import": "./dist/owned-program-instructions.js"
    },
    "./idl/arch-curve": "./idl/arch_curve.json",
    "./idl/arch-swap": "./idl/arch_swap.json",
    "./idl/arch-locker": "./idl/arch_locker.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "verify:idl": "node --import tsx scripts/verify-idl.mjs",
    "generate:idl": "node scripts/generate-idl-metadata.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:reference": "node --import tsx scripts/check-reference-quotes.mjs",
    "check:devnet": "node --import tsx scripts/check-devnet.mjs",
    "prepack": "npm run verify:idl -- --require-lf && npm run build && node scripts/check-package.mjs --verify-artifacts",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run verify:idl && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "@solana/kit": "8.5.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
